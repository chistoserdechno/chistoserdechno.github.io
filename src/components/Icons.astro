---
// Спрайт иконок: подключается один раз в Layout, дальше <svg><use href="#i-..."/></svg>
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12.5l2.6 2.5L16 9.5"/></symbol>
    <symbol id="i-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/></symbol>
    <!-- Услуги -->
    <symbol id="i-spray" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12h8v3l2 3v10a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 8 28V18l2-3z"/><path d="M11 12V8h6v4M17 8h3l2 2M11 8l-2-2"/><path d="M25 5v4M23 7h4M26 12v2M25 13h2"/></symbol>
    <symbol id="i-briefcase" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="24" height="17" rx="2.5"/><path d="M12 10V7.5A1.5 1.5 0 0 1 13.5 6h5A1.5 1.5 0 0 1 20 7.5V10M4 17h24M14 17v2h4v-2"/></symbol>
    <symbol id="i-roller" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="18" height="7" rx="2"/><path d="M23 8.5h3v6H15v4"/><rect x="13" y="18.5" width="4" height="9" rx="1.5"/></symbol>
    <symbol id="i-sparkle-box" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="22" height="22" rx="3"/><path d="M16 10v4M16 18v4M10 16h4M18 16h4M11 10.5l1 1M21 21.5l-1-1"/></symbol>
    <symbol id="i-window" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="20" height="24" rx="2"/><path d="M16 4v24M6 15h20M10 9l3-3M19 20l3-3"/></symbol>
    <symbol id="i-sofa" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14V10a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v4"/><path d="M4 16a2.5 2.5 0 0 1 5 0v2h14v-2a2.5 2.5 0 0 1 5 0v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M7 25v2M25 25v2"/></symbol>
    <!-- Доверие -->
    <symbol id="i-shield" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3l10 4v8c0 6.5-4.3 11.5-10 14-5.7-2.5-10-7.5-10-14V7z"/><path d="M11.5 16l3.2 3.2 6-6.2"/></symbol>
    <symbol id="i-leaf" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 25C7 13 14 6 26 6c0 12-7 19-19 19z"/><path d="M7 25L19 13"/></symbol>
    <symbol id="i-ruble" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="12"/><path d="M13 22V10h4.5a3.5 3.5 0 0 1 0 7H11M11 19.5h7"/></symbol>
    <symbol id="i-clock" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="12"/><path d="M16 9v7l4.5 3"/></symbol>
    <symbol id="i-badge" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="12" r="7"/><path d="M11.5 17.5L9.5 28l6.5-3.5 6.5 3.5-2-10.5"/></symbol>
    <symbol id="i-user-check" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="10" r="5"/><path d="M4 27c0-5 4-8.5 9-8.5 2 0 3.8.5 5.2 1.5M20 24l3 3 6-6"/></symbol>
    <symbol id="i-area" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="10" r="2.6"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></symbol>
    <!-- Мессенджеры/соцсети -->
    <symbol id="i-wa" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.4-.3z"/></symbol>
    <symbol id="i-tg" viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.3l-3.2 15c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2l-11 6.9-4.7-1.5c-1-.3-1-1 .2-1.5L20.5 3c.9-.3 1.6.2 1.4 1.3z"/></symbol>
    <symbol id="i-vk" viewBox="0 0 24 24" fill="currentColor"><path d="M12.8 17.5c-5.5 0-8.6-3.8-8.8-10h2.8c.1 4.6 2.1 6.5 3.7 6.9V7.5h2.6v3.9c1.6-.2 3.3-2 3.8-3.9h2.6a7.8 7.8 0 0 1-3.5 5.1 8 8 0 0 1 4.1 4.9h-2.9a5 5 0 0 0-4.1-3.6v3.6z"/></symbol>
    <symbol id="i-inst" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></symbol>
    <!-- Фирменный знак: крыша + сердце -->
    <symbol id="logo-mark" viewBox="0 0 64 52" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 30 L32 6 L45 16.5 V9 h6 v12.5 L61 30" stroke-width="2.2"/>
      <rect x="28" y="17" width="3.4" height="3.4" fill="currentColor" stroke="none"/><rect x="32.6" y="17" width="3.4" height="3.4" fill="currentColor" stroke="none"/>
      <rect x="28" y="21.6" width="3.4" height="3.4" fill="currentColor" stroke="none"/><rect x="32.6" y="21.6" width="3.4" height="3.4" fill="currentColor" stroke="none"/>
      <path d="M8 40c8 2 16-1 22-4M40 44c-6-4-9-7-9-10.5a4.6 4.6 0 0 1 9-1.4 4.6 4.6 0 0 1 9 1.4C49 37 46 40 40 44z" stroke-width="2"/>
    </symbol>
    <symbol id="i-heart" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 27c-7-5-11-9-11-14a5.5 5.5 0 0 1 11-2 5.5 5.5 0 0 1 11 2c0 5-4 9-11 14z"/></symbol>
    <symbol id="i-tool" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 5a6 6 0 0 0-5.6 8.2L5 22.6a2.2 2.2 0 0 0 3.1 3.1l9.4-9.4A6 6 0 0 0 26 11l-3.6 3.6-3.4-.6-.6-3.4L22 7a6 6 0 0 0-2-2z"/></symbol>
    <symbol id="i-key" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="16" r="6"/><path d="M17 16h11M24 16v4M28 16v3"/><circle cx="11" cy="16" r="1.5"/></symbol>
  </defs>
</svg>
